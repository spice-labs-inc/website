---
import KeyQuestionContent from "../content/KeyQuestion.mdx";
---

<section id="key-question">
  <div class="inner">
    <KeyQuestionContent />
  </div>
</section>

<style>
  section#key-question {
    padding-bottom: 0;
  }

  .inner {
    padding: 1.5rlh 2rlh 0;
    container-type: inline-size;

    @media (width < 24rlh) {
      padding-block: 1rlh;
    }
  }
</style>
<style is:global section#key-question .inner>
  h2 {
    margin-block: 0;
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 3rlh;
    text-align: center;

    @container (width < 32rlh) {
      font-size: 2rem;
      line-height: 2rlh;
      text-align: left;
    }
    @container (width < 24rlh) {
      font-size: 1.5rem;
      line-height: 2rlh;
    }
  }
</style>
