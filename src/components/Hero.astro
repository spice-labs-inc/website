---
import HeroHeader from "@/content/HeroHeader.mdx";
import HeroText from "@/content/HeroText.mdx";
import site from "@/content/site.json";
---

<section id="hero">
  <div class="inner">
    <div class="bg-diamonds"></div>
    <div class="hero-image">
      <img src="/images/HeroImage.svg" alt="Hero image" />
    </div>
    <div class="hero-content">
      <div class="hero-header">
        <HeroHeader />
      </div>
      <div class="hero-text">
        <HeroText />
        <div class="ctas">
          <a class="button" href={site.cta.url}>
            {site.cta.label}
          </a>
          <a class="button button-secondary" href="/questions">
            F.A.Q.
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    color: var(--color-light);
    background:
      url("/images/HeroBackground.svg") no-repeat right bottom,
      var(--color-black);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 3rlh;
    padding: 4rlh 3rlh;
    overflow: hidden;
    container-type: inline-size;

    @media screen and (width < 24rlh) {
      padding-inline: 1rlh;
    }

    @media screen and (height < 900px) {
      padding-block: 2rlh;
      gap: 2rlh;
    }

    @media screen and (height <= 768px) {
      padding-block: 1.5rlh;
      gap: 1.5rlh;
    }

    @media screen and (height < 700px) {
      padding-block: 1rlh;
      gap: 1rlh;
    }

    @media screen and (height < 568px) {
      padding-block: 0.5rlh;
      gap: 0.5rlh;
    }

    @media screen and (max-width: 768px) and (max-height: 900px) {
      padding-block: 1rlh;
      gap: 1rlh;
    }
  }

  .hero-image {
    display: flex;
    justify-content: flex-end;
    container-type: inline-size;

    @media screen and (width < 24rlh) {
      position: relative;
      margin-left: -1rlh;
      width: 100vw;
    }
  }
  .hero-image img {
    height: 18rlh;
    @container (width<900px) {
      height: 12rlh;
    }
    @container (width<600px) {
      height: 10rlh;
    }
    @media screen and (max-width: 600px) {
      width: 100%;
      object-fit: cover;
    }
    @media screen and (height < 900px) {
      height: 14rlh;
    }
    @media screen and (height <= 768px) {
      height: 13rlh;
    }
    @media screen and (height < 700px) {
      height: 10rlh;
    }
    @media screen and (height < 568px) {
      height: 8rlh;
    }
    @media screen and (max-width: 768px) and (max-height: 900px) {
      height: 10rlh;
    }
    @media screen and (max-width: 600px) and (max-height: 900px) {
      height: 8rlh;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: row;
    gap: 3rlh;
    @container (width < 40rlh) {
      gap: 2rlh;
    }
  }

  .hero-header {
    flex: 1;
    container-type: inline-size;

    h1 {
      letter-spacing: -0.05em;
      margin-block: 1rlh;
      font-size: 4.5rem;
      line-height: 4rlh;
      transform: translateY(var(--shift));
      @container (width < 30rlh) {
        font-size: 4rem;
        line-height: 4rlh;
      }
      @container (width < 27rlh) {
        margin-block: 1rlh;
        font-size: 3.5rem;
        line-height: 4rlh;
      }
      @container (width < 25rlh) {
        margin-block: 1rlh;
        font-size: 3rem;
        line-height: 4rlh;
      }
      @container (width < 21rlh) {
        margin-block: 3rlh 1rlh;
        font-size: 2.5rem;
        line-height: 2rlh;
      }
    }
  }

  .hero-text {
    flex: 1;
    font-size: 1.25rem;
    line-height: 2rlh;
    font-weight: 300;
  }

  @media (width < 40rlh) {
    .hero-content {
      flex-direction: column;
    }
    .hero-text {
      align-items: flex-start;
    }
  }

  .ctas {
    display: flex;
    gap: 0.5rlh;
  }
</style>

<style is:global>
  .hero-header h1 strong {
    color: var(--color-primary);
  }
</style>
