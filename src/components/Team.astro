---
import CardFlow from "./CardFlow.astro";
import { getCollection } from "astro:content";

const team = await getCollection("team");
const advisors = await getCollection("advisors");

function shuffle<T>(arr: Array<T>): Array<T> {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

function shuffleWithExceptions<T>(arr: Array<T>): Array<T> {
  const copy = arr.slice();
  const idx = copy.findIndex((item: any) => {
    const name = item?.data?.name;
    return typeof name === "string" && name.includes("Pollak");
  });
  if (idx === -1) return shuffle(copy);
  const [pollak] = copy.splice(idx, 1);
  return [pollak, ...shuffle(copy)];
}
---

<section id="team">
  <div class="tabs">
    <details name="team" open>
      <summary>Team</summary>
      <div class="content">
        <div class="content-inner">
          <CardFlow id="team-grid">
            {shuffleWithExceptions(team).map((p) => (
              <article class="card" aria-label={p.data?.name}>
                <img src={p.data?.image} alt={p.data?.name} loading="lazy" />
                <h3>{p.data?.name}</h3>
                <p>{p.data?.title}</p>
              </article>
            ))}
          </CardFlow>
        </div>
      </div>
    </details>

    <details name="team">
      <summary>Advisors</summary>
      <div class="content">
        <CardFlow id="advisors-grid">
          {shuffle(advisors).map((p) => (
            <article class="card" aria-label={p.data?.name}>
              <img src={p.data?.image} alt={p.data?.name} loading="lazy" />
              <h3>{p.data?.name}</h3>
            </article>
          ))}
        </CardFlow>
      </div>
    </details>
  </div>
</section>

<style>
  #team {
    position: relative;
    color: var(--color-light);
    background-color: var(--color-black);
  }

  .tabs {
    max-width: var(--content-max);
    margin-inline: auto;
    display: grid;
    grid-template:
      "tab  tab  tab  tab  tab  tab  tab  tab  tab  blank" min-content
      "body body body body body body body body body body" auto / min-content min-content min-content min-content min-content min-content min-content min-content min-content auto;
    column-gap: 1rlh;
    row-gap: 1rlh;

    container-type: inline-size;

    margin: 4rlh 3rlh 3rlh;
    @media (width < 480px) {
      margin: 4rlh 1rlh 1rlh;
    }

    summary {
      list-style-type: none;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;

      font-size: 2rem;
      line-height: 2rlh;

      [open] & {
        pointer-events: none;
      }
      [open] &::after {
        content: url("/images/Underline.svg");
        display: block;
        width: 2rlh;
        transform: translateY(-1rlh);
      }
    }

    details,
    details::details-content {
      display: contents;
    }

    .content {
      grid-column: 1 / -1;
      grid-row: 2;
      visibility: hidden;
      width: 100cqi;
      contain: inline-size;
      display: block;
      [open] & {
        visibility: visible;
        z-index: 1;
      }
    }

    .card {
      width: 14rlh;
      filter: sepia(20%) brightness(90%) hue-rotate(180deg);

      @media screen and (width < 480px) {
        width: 10rlh;
        min-width: 10rlh;
      }
      img {
        aspect-ratio: 1/1.3;
        object-fit: cover;
        width: 100%;
        display: block;
        filter: grayscale(1);
      }
    }
  }
</style>
