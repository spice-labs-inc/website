---
import Logo from "../assets/logo.svg";
---

<footer>
  <section id="footer">
    <div id="logo">
      <Logo />
      <div id="partner">
        <span>Available for government purchase through</span>
        <a href="/public-sector">
          <img src="/images/carahsoft-logo-white.svg" alt="Carahsoft" width="150" height="29" />
        </a>
      </div>
    </div>

    <div class="nav">
      <ul>
        <li>
          <a href="/team">Team & Advisors</a>
        </li>
        <li>
          <a href="/#contact">Contact</a>
        </li>
        <li>
          <a href="/public-sector">Public Sector</a>
        </li>
        <li>
          <a href="/pricing">Pricing</a>
        </li>
        <li>
          <a href="/#resources">Resources</a>
        </li>
      </ul>
      <ul>
        <li>
          <a href="https://docs.spicelabs.io">Documentation</a>
        </li>
        <li>
          <a href="https://blog.spicelabs.io">Blog</a>
        </li>
        <li>
          <a href="https://www.linkedin.com/company/spice-labs-inc">LinkedIn</a>
        </li>
        <li>
          <a href="https://documents.spicelabs.io/privacy/">Privacy Policy</a>
        </li>
        <li>
          <a href="https://documents.spicelabs.io/terms/">Terms of Service</a>
        </li>
      </ul>
    </div>
    <div class="copyright">© {new Date().getFullYear()} Spice Labs. All rights reserved.</div>
  </section>
</footer>

<style>
  footer {
    position: relative;
    min-height: 15rlh;
    background: url("/images/FooterBackground.svg") no-repeat center / 100% 100%;
    background-color: var(--color-black);
    color: var(--color-light);
  }

  #footer {
    max-width: var(--content-max);
    margin-inline: auto;
    display: grid;
    grid-template: "logo . ." auto / 3fr 2fr 2fr;
    @media screen and (width < 35rlh) {
      grid-template: "nav" auto "logo" auto / 1fr;
    }
    gap: 2rlh;
    padding: 2rlh 3rlh;
    padding-bottom: 3rlh;
  }

  #logo {
    grid-area: logo;
    margin-block-start: 4px;
  }

  /* Carahsoft brand guidelines: white logo on dark backgrounds only, full opacity,
     clear space on all sides at least the height of the "c" (~20px at this size). */
  #partner {
    margin-block-start: 2rlh;
    margin-block-end: 1.5rlh;
    display: flex;
    flex-direction: column;
    gap: 0.4rlh;
    font-size: 0.8rem;
    span {
      opacity: 0.85;
    }
    img {
      display: block;
      width: 150px;
      height: auto;
    }
  }

  .nav {
    grid-column: 2 / 4;
    grid-row: 1;
    @media screen and (width < 35rlh) {
      grid-area: nav;
    }
    display: grid;
    grid-template-columns: subgrid;

    ul {
      padding: 0;
      margin: 0;
      font-size: 1.5rem;
      line-height: 2rlh;
      li {
        margin-block-end: 1rlh;
      }
      @media screen and (width < 45rlh) {
        font-size: 1rem;
        line-height: 2rlh;
        li {
          margin-block-end: 0;
        }
      }
      @media screen and (width < 35rlh) {
        margin-block-start: 2rlh;
      }
      transform: translateY(var(--shift));
      list-style: none;
    }

    a {
      color: var(--color-light);
      text-decoration: none;
    }
  }

  .copyright {
    position: absolute;
    bottom: 1rlh;
    text-align: center;
    font-size: 0.8rem;
    opacity: 0.6;
    width: 100%;
    white-space: nowrap;
  }
</style>
